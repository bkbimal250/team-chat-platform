  "components": {
    "schemas": {
      "BlockCheck": {
        "properties": {
          "user_a_id": {
            "type": "string",
            "format": "uuid",
            "title": "User A Id"
          },
          "user_b_id": {
            "type": "string",
            "format": "uuid",
            "title": "User B Id"
          }
        },
        "type": "object",
        "required": [
          "user_a_id",
          "user_b_id"
        ],
        "title": "BlockCheck"
      },
      "ContactCreate": {
        "properties": {
          "phone": {
            "type": "string",
            "maxLength": 64,
            "minLength": 3,
            "title": "Phone"
          },
          "country": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Z]{2}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Country"
          },
          "local_label": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "Local Label"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "phone"
        ],
        "title": "ContactCreate"
      },
      "ContactPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/SavedContact"
            },
            "type": "array",
            "title": "Items"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          }
        },
        "type": "object",
        "required": [
          "items",
          "next_cursor"
        ],
        "title": "ContactPage"
      },
      "ContactPatch": {
        "properties": {
          "local_label": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "Local Label"
          },
          "phone": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 64,
                "minLength": 3
              },
              {
                "type": "null"
              }
            ],
            "title": "Phone"
          },
          "country": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Z]{2}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Country"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "ContactPatch"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "MatchItem": {
        "properties": {
          "input_index": {
            "type": "integer",
            "title": "Input Index"
          },
          "matched_user": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SafeUser"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "input_index",
          "matched_user"
        ],
        "title": "MatchItem"
      },
      "MatchRequest": {
        "properties": {
          "contacts": {
            "items": {
              "$ref": "#/components/schemas/PhoneInput"
            },
            "type": "array",
            "maxItems": 20,
            "minItems": 1,
            "title": "Contacts"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "contacts"
        ],
        "title": "MatchRequest"
      },
      "MatchResponse": {
        "properties": {
          "results": {
            "items": {
              "$ref": "#/components/schemas/MatchItem"
            },
            "type": "array",
            "title": "Results"
          }
        },
        "type": "object",
        "required": [
