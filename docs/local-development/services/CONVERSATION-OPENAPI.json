  "components": {
    "schemas": {
      "CType": {
        "type": "string",
        "enum": [
          "DIRECT",
          "GROUP"
        ],
        "title": "CType"
      },
      "DirectIn": {
        "properties": {
          "member_id": {
            "type": "string",
            "format": "uuid",
            "title": "Member Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "member_id"
        ],
        "title": "DirectIn"
      },
      "GroupIn": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Title"
          },
          "description": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "member_ids": {
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "type": "array",
            "maxItems": 10000,
            "minItems": 1,
            "title": "Member Ids"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "title",
          "member_ids"
        ],
        "title": "GroupIn"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "MemberIds": {
        "properties": {
          "member_ids": {
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "type": "array",
            "maxItems": 10000,
            "minItems": 1,
            "title": "Member Ids"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "member_ids"
        ],
        "title": "MemberIds"
      },
      "StateIn": {
        "properties": {
          "is_archived": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Is Archived"
          },
          "is_pinned": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Is Pinned"
          },
          "muted_until": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Muted Until"
          },
          "is_muted_forever": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Is Muted Forever"
          },
          "notification_level": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(ALL|MENTIONS|NONE)$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Notification Level"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "StateIn"
      },
      "Transfer": {
        "properties": {
          "member_id": {
            "type": "string",
            "format": "uuid",
            "title": "Member Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "member_id"
        ],
        "title": "Transfer"
      },
      "UpdateConversation": {
        "properties": {
          "title": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          },
          "description": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "avatar_media_id": {
            "anyOf": [
              {
                "type": "string",
