  "components": {
    "schemas": {
      "ContextRequest": {
        "properties": {
          "organization_id": {
            "type": "string",
            "format": "uuid",
            "title": "Organization Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "organization_id"
        ],
        "title": "ContextRequest"
      },
      "DeviceInput": {
        "properties": {
          "installation_id": {
            "type": "string",
            "maxLength": 256,
            "minLength": 16,
            "title": "Installation Id"
          },
          "platform": {
            "$ref": "#/components/schemas/DevicePlatform"
          },
          "device_name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Device Name"
          },
          "device_model": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "Device Model"
          },
          "os_version": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ],
            "title": "Os Version"
          },
          "app_version": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ],
            "title": "App Version"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "installation_id",
          "platform",
          "device_name"
        ],
        "title": "DeviceInput"
      },
      "DevicePlatform": {
        "type": "string",
        "enum": [
          "ANDROID",
          "IOS",
          "WEB"
        ],
        "title": "DevicePlatform"
      },
      "DeviceResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "platform": {
            "type": "string",
            "title": "Platform"
          },
          "device_name": {
            "type": "string",
            "title": "Device Name"
          },
          "device_model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Device Model"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "first_seen_at": {
            "type": "string",
            "format": "date-time",
            "title": "First Seen At"
          },
          "last_seen_at": {
            "type": "string",
            "format": "date-time",
            "title": "Last Seen At"
          },
          "is_current": {
            "type": "boolean",
            "title": "Is Current"
          }
        },
        "type": "object",
        "required": [
          "id",
          "platform",
          "device_name",
          "device_model",
          "status",
          "first_seen_at",
          "last_seen_at",
          "is_current"
        ],
        "title": "DeviceResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "MeResponse": {
        "properties": {
          "identity": {
            "additionalProperties": true,
            "type": "object",
            "title": "Identity"
          },
          "session": {
            "additionalProperties": true,
            "type": "object",
            "title": "Session"
          },
          "context": {
            "additionalProperties": true,
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "identity",
          "session",
          "context"
        ],
        "title": "MeResponse"
      },
      "OTPRequest": {
        "properties": {
          "phone_number": {
            "type": "string",
            "maxLength": 64,
            "title": "Phone Number"
          },
          "purpose": {
            "type": "string",
            "pattern": "^(LOGIN|REGISTER|PHONE_VERIFY|RECOVERY)$",
            "title": "Purpose"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "phone_number",
          "purpose"
        ],
        "title": "OTPRequest"
      },
      "OTPRequestResponse": {
        "properties": {
          "challenge_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Challenge Id"
          },
          "message": {
            "type": "string",
            "title": "Message",
            "default": "If eligible, a verification code has been sent."
          },
          "development_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Development Code"
          }
        },
        "type": "object",
        "title": "OTPRequestResponse"
      },
      "OTPVerifyRequest": {
        "properties": {
          "challenge_id": {
            "type": "string",
            "format": "uuid",
            "title": "Challenge Id"
          },
          "code": {
            "type": "string",
            "pattern": "^\\d{6}$",
            "title": "Code"
          },
          "device": {
            "$ref": "#/components/schemas/DeviceInput"
          },
          "organization_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Organization Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "challenge_id",
          "code",
          "device"
        ],
        "title": "OTPVerifyRequest"
      },
      "QRAuthorizeRequest": {
        "properties": {
          "secret": {
            "type": "string",
            "maxLength": 512,
            "minLength": 32,
            "title": "Secret"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "secret"
        ],
        "title": "QRAuthorizeRequest"
      },
      "QRConsumeRequest": {
        "properties": {
          "secret": {
            "type": "string",
            "maxLength": 512,
            "minLength": 32,
            "title": "Secret"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "secret"
        ],
        "title": "QRConsumeRequest"
      },
      "QRCreateRequest": {
        "properties": {
          "installation_id": {
            "type": "string",
            "maxLength": 256,
            "minLength": 16,
            "title": "Installation Id"
          },
          "platform": {
            "$ref": "#/components/schemas/DevicePlatform"
          },
          "device_name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Device Name"
          },
          "device_model": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "Device Model"
          },
          "os_version": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ],
            "title": "Os Version"
          },
          "app_version": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ],
            "title": "App Version"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "installation_id",
          "platform",
          "device_name"
        ],
        "title": "QRCreateRequest"
      },
      "QRCreateResponse": {
        "properties": {
          "challenge_id": {
            "type": "string",
            "format": "uuid",
            "title": "Challenge Id"
          },
          "payload": {
            "type": "string",
            "title": "Payload"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "title": "Expires At"
