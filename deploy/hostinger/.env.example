# Copy to .env on the VPS (never commit .env). All values are placeholders.

# --- Public endpoints (Caddy + clients) ---
API_DOMAIN=api.example.com
WS_DOMAIN=ws.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
REALTIME_PUBLIC_WSS_URL=wss://ws.example.com/api/v1/realtime

# --- Postgres (single instance, logical DBs) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-strong-postgres-password
# URL-encoded password for compose interpolation (use python -c "import urllib.parse; print(urllib.parse.quote('...'))")
POSTGRES_PASSWORD_URLENCODED=replace-with-url-encoded-postgres-password

# --- RabbitMQ ---
RABBITMQ_USER=globalchat
RABBITMQ_PASSWORD=replace-with-strong-rabbitmq-password

# --- Shared secrets (generate random >=32 chars each) ---
SECRET_KEY=replace-django-secret-key
SERVICE_AUTH_TOKEN=replace-internal-service-token-min-32-chars
CONTACT_MATCHING_SECRET=replace-contact-matching-secret-min-32-chars
MEDIA_JWT_SECRET=replace-if-legacy-media-jwt-used

# --- Identity JWT (RS256). Generate keypair; never commit private key. ---
ACCESS_TOKEN_PRIVATE_KEY=replace-with-pem-private-key-escaped-or-use-env-file-mount
ACCESS_TOKEN_PUBLIC_KEY=replace-with-pem-public-key
IDENTITY_JWT_PUBLIC_KEY=replace-same-as-access-token-public-key-multiline-ok

# --- AWS S3 (media ciphertext only). Use IAM user keys on VPS, not in git. ---
AWS_REGION=ap-south-1
MEDIA_S3_BUCKET=your-globalchat-media-bucket-name
AWS_ACCESS_KEY_ID=replace-at-runtime-on-vps
AWS_SECRET_ACCESS_KEY=replace-at-runtime-on-vps
# Optional: leave empty for real AWS S3
MEDIA_S3_ENDPOINT_URL=

# --- App URLs (web; optional if not hosting web on same VPS) ---
WEB_APP_BASE_URL=https://app.example.com

# --- Runtime ---
DEBUG=false
APP_ENV=production
ENVIRONMENT=production
ALLOWED_HOSTS=api.example.com,localhost
