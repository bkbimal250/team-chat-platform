APP_ENV=local
SERVICE_NAME=identity-service
DATABASE_URL=postgresql+asyncpg://identity_app:change-me@localhost:55432/identity_db
REDIS_URL=redis://localhost:6379/0
RABBITMQ_URL=amqp://change-me:change-me@rabbitmq:5672/organization
ACCESS_TOKEN_PRIVATE_KEY_PATH=/run/secrets/identity-jwt-private.pem
ACCESS_TOKEN_PUBLIC_KEY_PATH=/run/secrets/identity-jwt-public.pem
ACCESS_TOKEN_KID=local-2026-01
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_PROVIDER=development
SMS_PROVIDER=
SMS_API_BASE_URL=
SMS_USERNAME=
SMS_API_KEY=
SMS_ROUTE=
SMS_SENDER_ID=
SMS_TEMPLATE_ID=
SMS_MESSAGE_TEMPLATE=
SMS_TIMEOUT_SECONDS=5
VONAGE_API_KEY=replace-with-vonage-api-key
VONAGE_API_SECRET=replace-with-vonage-api-secret
VONAGE_BRAND=GlobalChat
VONAGE_VERIFY_BASE_URL=https://api.nexmo.com
VONAGE_TIMEOUT_SECONDS=5
QR_CHALLENGE_TTL_SECONDS=120
REGISTRATION_POLICY=INVITE_ONLY
ORGANIZATION_SERVICE_URL=http://localhost:8000
INTERNAL_SERVICE_TOKEN=replace-with-rotatable-internal-token
TRUSTED_PROXY_CIDRS=
CORS_ALLOWED_ORIGINS=http://localhost:3000
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=10
REDIS_MAX_CONNECTIONS=20
