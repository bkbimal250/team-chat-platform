APP_ENV=local
SERVICE_NAME=identity-service
DATABASE_URL=postgresql+asyncpg://identity_app:replace-password@localhost:55432/identity_db
REDIS_URL=redis://localhost:6379/0
RABBITMQ_URL=amqp://identity_service:replace-password@localhost:5672/organization
ACCESS_TOKEN_PRIVATE_KEY_PATH=/run/secrets/identity-jwt-private.pem
ACCESS_TOKEN_PUBLIC_KEY_PATH=/run/secrets/identity-jwt-public.pem
ACCESS_TOKEN_KID=local-2026-01
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
QR_CHALLENGE_TTL_SECONDS=120
REGISTRATION_POLICY=INVITE_ONLY
DEVELOPMENT_OTP_ENABLED=true
ORGANIZATION_SERVICE_URL=http://localhost:8000
INTERNAL_SERVICE_TOKEN=replace-with-rotatable-internal-token
TRUSTED_PROXY_CIDRS=
CORS_ALLOWED_ORIGINS=http://localhost:3000
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=10
REDIS_MAX_CONNECTIONS=20
