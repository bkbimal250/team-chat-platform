APP_ENV=development
DATABASE_URL=postgresql+asyncpg://postgres:replace-me@localhost:5432/teamchat_notification_db
RABBITMQ_URL=amqp://notification:replace-me@localhost:5672/notification

# JWT verification. Required in production.
JWT_PUBLIC_KEY=
JWT_ALGORITHM=RS256
JWT_ISSUER=identity-service
JWT_AUDIENCE=team-chat-platform

# Set fcm with FIREBASE_CREDENTIALS_JSON in production.
PUSH_PROVIDER=fake
FIREBASE_CREDENTIALS_JSON=
DELIVERY_POLL_SECONDS=1
