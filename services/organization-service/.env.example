SECRET_KEY=replace-with-a-random-local-secret
ENVIRONMENT=local
DATABASE_URL=postgresql://user:password@localhost:5432/teamchat_organization_db
RABBITMQ_URL=amqp://user:password@localhost:5672/organization
INTERNAL_SERVICE_TOKEN=replace-with-shared-internal-service-token-at-least-32-chars
JWT_PUBLIC_KEY=
JWT_ALGORITHM=RS256
JWT_ISSUER=identity-service
JWT_AUDIENCE=team-chat-platform
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=
OUTBOX_MAX_RETRIES=10
INVITATION_TTL_HOURS=48
WEB_APP_BASE_URL=http://localhost:3001
LOG_LEVEL=INFO
