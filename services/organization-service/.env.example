SECRET_KEY=replace-with-a-random-local-secret
DATABASE_URL=postgresql://organization_migrator:replace-password@localhost:55432/organization_db
RABBITMQ_URL=amqp://organization_service:replace-password@localhost:5672/organization
DJANGO_SETTINGS_MODULE=config.settings.local
DEV_CONTEXT_ENABLED=true
DEBUG=false
ENVIRONMENT=local
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
