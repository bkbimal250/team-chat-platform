APP_ENV=local
SERVICE_NAME=conversation-service
DATABASE_URL=postgresql+asyncpg://conversation_app:change-me@localhost:55432/conversation_db
REDIS_URL=redis://localhost:16379/1
RABBITMQ_URL=amqp://change-me:change-me@rabbitmq:5672/organization
IDENTITY_SERVICE_URL=http://localhost:8001
ORGANIZATION_SERVICE_URL=http://localhost:8000
USER_SERVICE_URL=http://localhost:8002
INTERNAL_SERVICE_TOKEN=replace-with-rotatable-service-token
JWT_PUBLIC_KEY=
JWT_ALGORITHM=RS256
JWT_ISSUER=identity-service
JWT_AUDIENCE=team-chat-platform
DEFAULT_GROUP_MEMBER_LIMIT=250
CORS_ALLOWED_ORIGINS=http://localhost:3000
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=10
