# Media Service environment configuration
APP_ENV=development
MEDIA_STORAGE_BACKEND=fake

# Required when MEDIA_STORAGE_BACKEND=s3, including production.
AWS_REGION=
MEDIA_S3_BUCKET=

# Optional: local S3-compatible endpoint only. Do not configure AWS credentials here.
MEDIA_S3_ENDPOINT_URL=

DATABASE_URL=postgresql+asyncpg://postgres:replace-me@localhost:5432/teamchat_media_db

# Identity-issued GlobalChat access-token verification. Media receives only
# the public key and never the Identity private signing key.
JWT_PUBLIC_KEY=
JWT_ALGORITHM=RS256
JWT_ISSUER=identity-service
JWT_AUDIENCE=team-chat-platform
