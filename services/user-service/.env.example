APP_ENV=development
DATABASE_URL=postgresql+asyncpg://user_app:replace-me@postgres:5432/teamchat_user_db
REDIS_URL=redis://redis:6379/0
RABBITMQ_URL=amqp://replace-me:replace-me@rabbitmq:5672/
RABBITMQ_EXCHANGE=user.events
RABBITMQ_PREFETCH_COUNT=20
OUTBOX_BATCH_SIZE=50
OUTBOX_POLL_SECONDS=1.0
IDENTITY_SERVICE_URL=http://identity-service:8001
INTERNAL_SERVICE_TOKEN=
IDENTITY_JWT_PUBLIC_KEY=
IDENTITY_JWT_ALGORITHM=RS256
IDENTITY_JWT_ISSUER=identity-service
WORKSPACE_SEARCH_RATE_LIMIT=30
WORKSPACE_SEARCH_RATE_WINDOW_SECONDS=60
